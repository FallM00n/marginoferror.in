---
layout: base.njk
nav: projects
---
<article class="article-wrap">
  <a class="back-link" href="/projects/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> All projects</a>
  <header class="article-header">
    <div class="project-kicker">{% for k in kicker %}<span>{{ k }}</span>{% endfor %}</div>
    <h1>{{ title }}</h1>
    {% if dek %}<p class="article-standfirst">{{ dek }}</p>{% endif %}
    <div class="article-meta"><span>Project {{ number }}</span>{% if status %}<span>{{ status }}</span>{% endif %}</div>
  </header>
  {% if cover %}<figure class="article-cover"><img src="{{ cover }}" alt=""></figure>{% endif %}
  <div class="prose project-body">
    {{ content | safe }}
  </div>
  <footer class="article-footer">
    <a class="back-link" href="/projects/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> All projects</a>
  </footer>
</article>
