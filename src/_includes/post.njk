---
layout: base.njk
nav: writing
---
<article class="article-wrap">
  <a class="back-link" href="/writing/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> All writing</a>
  <header class="article-header">
    <span class="eyebrow">{{ categories | join(" · ") }}</span>
    <h1>{{ title }}</h1>
    {% if dek %}<p class="article-standfirst">{{ dek }}</p>{% endif %}
    <div class="article-meta"><span>By {{ site.author }}</span><time datetime="{{ date }}">{{ date | longDate }}</time>{% if readtime %}<span>{{ readtime }} read</span>{% endif %}</div>
  </header>
  {% if cover %}<figure class="article-cover"><img src="{{ cover }}" alt=""></figure>{% endif %}
  <div class="article-body prose">
    {{ content | safe }}
  </div>
  <footer class="article-footer">
    <div class="author-note">
      <span class="eyebrow">About the author</span>
      <p>{{ site.author }} writes <em>Margin of Error</em> about AI, marketing, media, and the operational choices that quietly decide outcomes.</p>
    </div>
    {% set nxt = collections.posts | nextInList(page.url) %}
    {% if nxt %}<a class="next-essay" href="{{ nxt.url }}"><span>Read next</span><strong>{{ nxt.data.title }}</strong><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a>{% endif %}
  </footer>
</article>
