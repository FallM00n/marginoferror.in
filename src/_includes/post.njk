---
layout: base.njk
nav: writing
---
<article>
  <header class="art-head">
    <span class="kick">{{ categories | join(" · ") }}</span>
    <h1>{{ title }}</h1>
    {% if dek %}<p class="standfirst">{{ dek }}</p>{% endif %}
    <div class="byline"><b>{{ site.author }}</b> <span class="sep">/</span> <span class="tnum">{{ date | monthYear }}</span>{% if readtime %} <span class="sep">/</span> {{ readtime }} read{% endif %}</div>
  </header>

  <div class="prose">
    {{ content | safe }}
  </div>

  <div class="art-foot">
    <p class="abt"><b>{{ site.author }}</b> runs international content operations at KukuFM. He writes <em>Margin of Error</em> about AI, marketing, media, and the operational decisions that quietly decide outcomes.</p>
    <a class="more-link" href="/writing/">More writing <span aria-hidden="true">&rarr;</span></a>
  </div>
</article>
