<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if nav == "home" %}{{ site.title }}{% else %}{{ title }} · {{ site.title }}{% endif %}</title>
<meta name="description" content="{{ dek or site.description }}">
<meta property="og:title" content="{% if nav == 'home' %}{{ site.title }}{% else %}{{ title }}{% endif %}">
<meta property="og:description" content="{{ dek or site.description }}">
<meta property="og:type" content="{% if nav == 'writing' and title %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta name="twitter:card" content="summary">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700&display=swap">
<link rel="stylesheet" href="/styles.css">
</head>
<body>

<div class="progress" aria-hidden="true"><i id="pbar"></i></div>

<header class="site">
  <div class="bar">
    <a class="brand" href="/" aria-label="Margin of Error, home">Margin of Error <span class="pm">&plusmn;</span></a>
    <nav class="top" aria-label="Primary">
      <a href="/" class="{{ 'active' if nav == 'home' else '' }}">Home</a>
      <a href="/writing/" class="{{ 'active' if nav == 'writing' else '' }}">Writing</a>
      <a href="/about/" class="{{ 'active' if nav == 'about' else '' }}">About</a>
    </nav>
    <button class="toggle" id="toggle" aria-label="Toggle light or dark theme" title="Toggle theme">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
    </button>
  </div>
</header>

<main class="anim">
{{ content | safe }}
</main>

<footer class="site">
  <div class="foot">
    <div>
      <div class="fname">Margin of Error <span class="pm">&plusmn;</span></div>
      <p class="tag">Case studies and arguments on AI, marketing, and media, by {{ site.author }}.</p>
      <p class="now"><b>Now &middot;</b> dubbing microdramas into Bahasa Indonesia, and reading about what makes a story travel.</p>
    </div>
    <div class="links">
      <a href="mailto:{{ site.email }}"><span class="ar">&rarr;</span> {{ site.email }}</a>
      <a href="{{ site.linkedin }}" target="_blank" rel="noopener"><span class="ar">&rarr;</span> LinkedIn</a>
      <a href="/writing/"><span class="ar">&rarr;</span> Writing</a>
    </div>
  </div>
</footer>

<script>
(function(){
  // theme
  var root=document.documentElement, tb=document.getElementById("toggle");
  try{ var s=localStorage.getItem("moe-theme"); if(s) root.setAttribute("data-theme",s); }catch(e){}
  if(tb) tb.addEventListener("click",function(){
    var cur=root.getAttribute("data-theme");
    var dark = cur ? cur==="dark" : matchMedia("(prefers-color-scheme: dark)").matches;
    var next = dark ? "light" : "dark";
    root.setAttribute("data-theme",next);
    try{ localStorage.setItem("moe-theme",next); }catch(e){}
  });

  // reading progress (only on pages with an article)
  var pbar=document.getElementById("pbar"), art=document.querySelector("article");
  function bar(){
    if(!art){ pbar.style.width="0"; return; }
    var d=document.documentElement, s=d.scrollHeight-d.clientHeight;
    pbar.style.width=(s>0?Math.max(0,Math.min(100,(d.scrollTop/s)*100)):0)+"%";
  }
  window.addEventListener("scroll",bar,{passive:true});
  window.addEventListener("resize",bar); bar();

  // writing filter
  var filters=document.getElementById("filters");
  if(filters){
    filters.addEventListener("click",function(e){
      var b=e.target.closest(".chip"); if(!b) return;
      var cat=b.getAttribute("data-cat");
      filters.querySelectorAll(".chip").forEach(function(c){c.classList.toggle("on",c===b);});
      var any=false;
      document.querySelectorAll("#writing-list .entry").forEach(function(en){
        var cats=(en.getAttribute("data-cats")||"").split("|");
        var show=(cat==="All"||cats.indexOf(cat)>-1);
        en.classList.toggle("hide",!show); if(show) any=true;
      });
      var empty=document.getElementById("empty");
      if(empty) empty.hidden=any;
    });
  }
})();
</script>
</body>
</html>
